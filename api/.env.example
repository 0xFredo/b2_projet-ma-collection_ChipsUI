# Configuration de la base de données PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chips_db

# Clé secrète JWT, générer une clé sécurisée avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=votre_cle_secrete_ici_32_caracteres_min

# Algorithme de chiffrement JWT
ALGORITHM=HS256

# Durée de validité du token JWT en minutes (ex: 60 = 1h)
ACCESS_TOKEN_EXPIRE_MINUTES=60