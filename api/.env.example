# Configuration de la base de données SQLite
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Clé secrète JWT, générer une clé sécurisée avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=votre_cle_secrete_ici_32_caracteres_min

# Algorithme de chiffrement JWT
ALGORITHM=HS256

# Durée de validité du token JWT en minutes (ex: 1440 = 24 heures)
ACCESS_TOKEN_EXPIRE_MINUTES=1440